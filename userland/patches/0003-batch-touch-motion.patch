+		    batch[sample].type == HAKIOS_TOUCH_MOVE &&
+		    batch[sample + 1].type == HAKIOS_TOUCH_MOVE &&
+		    batch[sample].finger == batch[sample + 1].finger) {
+			sample++;
+		}
+		t = batch[sample];
