+// Opt-in capture of our own test workloads, before fake completion. The caller
+// creates a private directory. Imported buffers are refused to avoid collecting
+// unrelated IOSurface/user memory. A failed capture rejects the mock submission.
+static int capture_submit(MockConn *c,const struct vgpu_submit *a)
+{
+    const char *dir=getenv("VGPU_MOCK_CAPTURE_DIR");
+    if(!dir || !*dir)return 0;
+    if(a->bo_handle_count>256)return -E2BIG;
+    const uint32_t *handles=(const uint32_t *)(uintptr_t)a->bo_handles;
+    size_t total=0;
+    for(uint32_t i=0;i<a->bo_handle_count;i++) {
+        MockBO *b=bo(c,handles[i]);
+        if(!b || b->imported || b->size>32*1024*1024)return -EINVAL;
+        total+=b->size;if(total>64*1024*1024)return -E2BIG;
+    }
+    char path[4096];
+    int n=snprintf(path,sizeof path,"%s/submit-%llu.json",dir,(unsigned long long)(c->seq+1));
+    if(n<0 || (size_t)n>=sizeof path)return -ENAMETOOLONG;
+    FILE *meta=fopen(path,"wx");if(!meta)return -errno;
+    fprintf(meta,"{\"jc\":%llu,\"requirements\":%u,\"bos\":[",(unsigned long long)a->jc,a->requirements);
+    int result=0;
+    for(uint32_t i=0;i<a->bo_handle_count;i++) {
+        MockBO *b=bo(c,handles[i]);
+        n=snprintf(path,sizeof path,"%s/submit-%llu-bo-%u.bin",dir,(unsigned long long)(c->seq+1),handles[i]);
+        if(n<0 || (size_t)n>=sizeof path) {result=-ENAMETOOLONG;break;}
+        FILE *f=fopen(path,"wbx");if(!f) {result=-errno;break;}
+        if(fwrite(b->addr,1,b->size,f)!=b->size)result=-EIO;
+        if(fclose(f))result=-EIO;
+        if(result)break;
+        fprintf(meta,"%s{\"handle\":%u,\"va\":%llu,\"size\":%zu}",i?",":"",handles[i],(unsigned long long)b->va,b->size);
+    }
+    fprintf(meta,"]}\n");if(fclose(meta))result=-EIO;
+    return result;
+}
